# Ignore bundler config
/.bundle

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp/**/*

# Ignore the database configuration

# Ignore sass cache
/.sass-cache/
/config/master.key
/config/credentials/*.key
/config/secrets.yml
/config/initializers/secret_token.rb

# Local environment and editor backups
.env
.env.*
*~
*.swp
*.swo
\#*#
.#*

# Generated assets and packaged dependencies
/public/assets/
/public/dev-assets/
/vendor/cache/
/storage/*

!/storage/.keep
