# Ignore bundler config
/.bundle

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp/**/*

# Ignore the database configuration
/config/database.yml

# Ignore sass cache
/.sass-cache/
/config/master.key

# Local environment and editor backups
.env
.env.*
*~
*.swp
*.swo

# Generated assets and packaged dependencies
/public/assets/
/public/dev-assets/
/vendor/cache/
