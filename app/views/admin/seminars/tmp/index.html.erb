<% content_for :nav do %>
<li class="parent">
  <%= link_to('Seminars', seminars_path) %>
  <ul>
    <li>
      <%= link_to('Create New Seminar', new_seminar_path) %>
    </li>
  </ul>
</li>
<li>
  <%= link_to('Participants', participants_path) %>
</li><li>
  <%= link_to('Registrations', registrations_path) %>
</li>
<li>
  <%= link_to('Future Faculty Program', future_faculty_path) %>
</li>
<li>
  <%= link_to('Application Settings', settings_path) %>
</li>
<% end %>

<div class="grid">
  <% if Current.user %>
  <h1>Welcome, <%= Current.user.name %></h1>
  <% end %>
</div>

<div class="content">
  <div>
    <h1>Seminars</h1>
    <p>All seminars with the tag <%= @display_tag %>.</p>
  </div><div class="sidebar">
    <div class="simple">
      <h2>
	<%= link_to("Create New Seminar",
	    new_admin_seminar_path, class: "btn wide") %>
      </h2>
    </div>
  </div>
</div>

<div class="boxes grey grid column2">
  <%= render( "seminars",
      :seminars => @offered_seminars,
  :title => "Open for Registration",
  :css_class => "published",
  :no_seminars_message => "We do not have any upcoming seminars.") %>

    <%= render "seminars", :seminars => @development_seminars,
    :title => "Closed for Registration",
    :css_class => "development",
    :no_seminars_message => "We do not have any seminars in development." %>

    <%= render "seminars", :seminars => @expired_seminars,
    :title => "Ended Seminars",
    :css_class => "expired",
    :no_seminars_message => "We do not have any ended seminars." %>
</div>
