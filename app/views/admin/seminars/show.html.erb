<% cmu_title @seminar.title, "Seminars" %>
<% cmu_breadcrumb link_to("Seminars", seminars_path), @seminar.title %>
<% cmu_nav "seminars" %>
<% order = { "confirmed" => 0, "pending" => 1, "canceled" => 2 } %>
<% registrations = @seminar.registrations.includes(:waitlist_status).reject { |r| r.participant.nil? }
                     .sort_by { |r| [order.fetch(r.waitlist_status&.key, 3), r.participant.sortable_name.downcase] } %>
<div class="content">
  <div>
    <%= render "heading", seminar: @seminar %>

    <h2>Registrations</h2>
    <% if registrations.empty? %>
      <p class="cmu-empty">No one has registered yet.</p>
    <% else %>
      <div data-controller="selection">
        <%= form_with url: statuses_admin_seminar_path(@seminar), method: :patch, id: "prg-bulk", class: "cmu-bulk-bar" do %>
          <span class="cmu-selection-count" aria-live="polite" data-selection-target="count">No people selected</span>
          <button class="btn small" type="submit" name="status" value="confirmed" data-selection-target="action" hidden>Confirm</button>
          <button class="btn small ghost" type="submit" name="status" value="pending" data-selection-target="action" hidden>Move to Waitlist</button>
          <button class="btn small ghost" type="submit" name="status" value="canceled" data-selection-target="action" hidden>Cancel</button>
        <% end %>
        <table class="alternate cmu-full">
          <thead>
            <tr>
              <th class="cmu-select-cell"><label><input type="checkbox" aria-label="Select all" data-selection-target="all" data-action="selection#toggleAll"></label></th>
              <th scope="col">Name</th>
              <th scope="col" class="cmu-fit">Andrew ID</th>
              <th scope="col" class="cmu-fit">Student Class</th>
              <th scope="col" class="cmu-fit">Status</th>
              <th scope="col" class="cmu-fit"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% registrations.each do |registration| %>
              <% participant = registration.participant %>
              <% status = registration.waitlist_status&.key %>
              <tr>
                <td class="cmu-select-cell"><label><input type="checkbox" name="registration_ids[]" value="<%= registration.id %>" form="prg-bulk"
                  aria-label="Select <%= participant.name %>" data-selection-target="row" data-action="selection#update"></label></td>
                <td><%= link_to participant.name, participant_path(participant) %></td>
                <td class="cmu-fit"><%= participant.andrewid %></td>
                <td class="cmu-fit"><%= participant.student_class %></td>
                <td class="cmu-fit"><%= render "registration_pill", status: %></td>
                <td class="cmu-fit">
                  <div class="cmu-row-buttons">
                    <% path = status_admin_registration_path(registration) %>
                    <% if status == "confirmed" %>
                      <%= button_to "Move to Waitlist", path, method: :patch, params: { status: "pending" }, class: "btn small ghost" %>
                      <%= render "row_menu", id: "prg-menu-#{registration.id}", name: participant.name,
                                 buttons: [["Cancel", path, { status: "canceled" }]] %>
                    <% elsif status == "pending" %>
                      <%= button_to "Confirm", path, method: :patch, params: { status: "confirmed" }, class: "btn small" %>
                      <%= render "row_menu", id: "prg-menu-#{registration.id}", name: participant.name,
                                 buttons: [["Cancel", path, { status: "canceled" }]] %>
                    <% else %>
                      <%= button_to "Confirm", path, method: :patch, params: { status: "confirmed" }, class: "btn small ghost" %>
                      <%= render "row_menu", id: "prg-menu-#{registration.id}", name: participant.name,
                                 buttons: [["Move to Waitlist", path, { status: "pending" }], ["Remove", path, { status: "remove" }]] %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div><div class="sidebar">
    <%= render "sidebar", seminar: @seminar %>
  </div>
</div>
