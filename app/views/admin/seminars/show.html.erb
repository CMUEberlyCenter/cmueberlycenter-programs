<% update_document_title(add: "#{@seminar.title}") %>
<% update_breadcrumbs(add: link_to('Seminars', seminars_path)) %>
<% update_breadcrumbs(add: "#{@seminar.title}") %>
<% content_for :nav do %>
<li class="parent ancestor">
  <%= link_to('Seminars', seminars_path) %>
  <ul>
    <li>
      <%= link_to('Create New Seminar', new_seminar_path) %>
    </li>
    <li class="active">
      <%= link_to("#{@seminar.title}", admin_seminar_url(@seminar)) %>
    </li>
  </ul>
</li><li>
  <%= link_to('Registrations', registrations_path) %>
</li><li>
  <%= link_to('Participants', participants_path) %>
</li><li>
  <%= link_to('Future Faculty Program', future_faculty_path) %>
</li><li>
  <%= link_to('Application Settings', settings_path) %>
</li>
<% end %>

<div class="content">
  <div>
    <h1><%= @seminar.title %></h1>
    <p class="date"><%= raw @seminar.formatted_timespan %></p>
    <p class="description"><%= raw @seminar.description %></p>

    <h2>Registration Management</h2>

        <%= form_tag change_registration_status_multiple_path(seminar: @seminar), method: :patch do %>
  <div>

    <p>
      <%= hidden_field_tag "selected", "" %>
      <%= select_tag 'registration_status_key', options_for_select(Registration::WaitlistStatusType.actions_dropdown), class: 'inline' %>
      <%= submit_tag "Update Selected", class: "small" %>
    </p>
  </div>


  <table>
      <tr class="invert">
          <th class="p_select"><%= check_box_tag("all_participants","") %></th>
          <th style="width:50%">Name</th>
          <th>Status</th>
	  <th>Affiliation</th>
	  <th style="width:100%">Actions</th>
      </tr>

      <%# @seminar.registrations.confirmed.sort { |a,b| a.participant.name <=> b.participant.name }.each do |registration| %>
      <% @seminar.registrations.confirmed.each do |registration| %>
      <tr>
        <td class="p_select"><%= check_box_tag("participants[select_#{registration.participant.andrewid}]", registration.participant.andrewid, false, class: 'participant') %></td>
        <td><%= link_to "#{registration.participant.name} ( #{registration.participant.andrewid })", participant_path(registration.participant) %></td>
	<td>Confirmed</td>
	<td><%= registration.participant.student_class %></td>
	<td>
	  <%= button_to("Waitlist", { action: "change_status", id: registration, params: {new_status: 'pending'} },method: :patch) %>
	  <%= button_to("Cancel", { action: "change_status", id: registration, params: {new_status: 'canceled'} },method: :patch) %>
	</td>
      </tr>
      <% end%>

      <% @seminar.registrations.pending.sort { |a,b| a.participant.name <=> b.participant.name }.each do |registration| %>
      <tr>
        <td class="p_select"><%= check_box_tag("participants[select_#{registration.participant.andrewid}]", registration.participant.andrewid, false, class: 'participant') %></td>
	<td><%= link_to "#{registration.participant.name} ( #{registration.participant.andrewid })", participant_path(registration.participant) %></td>
	<td>Pending</td>
	<td><%= registration.participant.student_class %></td>
	<td><%= button_to("Confirm", { action: "change_status", id: registration, params: {new_status: 'confirmed'} },method: :patch,  class: "at-btn", style: "float: left") %>
	<%= button_to("Cancel", { action: "change_status", id: registration, params: {new_status: 'canceled'} },method: :patch,  class: "at-btn", style: "float: left") %></td>
      </tr>
      <% end%>

      <% @seminar.registrations.canceled.sort { |a,b| a.participant.name <=> b.participant.name }.each do |registration| %>
            <tr>
        <td class="p_select"><%= check_box_tag("participants[select_#{registration.participant.andrewid}]", registration.participant.andrewid, false, class: 'participant') %></td>
	<td><%= link_to "#{registration.participant.name} ( #{registration.participant.andrewid })", participant_path(registration.participant) %></td>
        <td>Canceled</td>
	<td><%= registration.participant.student_class %></td>
	<td><%= button_to("Pending", { action: "change_status", id: registration, params: {new_status: 'pending'} },method: :patch,  class: "at-btn", style: "float: left") %>
	  <%= button_to("Confirm", { action: "change_status", id: registration, params: {new_status: 'confirmed'} },method: :patch,  class: "at-btn", style: "float: left") %>
	  <%= button_to("Destroy", { action: "change_status", id: registration, params: {new_status: 'nil'} },method: :patch,  class: "at-btn", style: "float: left") %></td>
	</td>
      </tr>
	    <% end%>
  </table>
    <% end %>
</div><div class="sidebar">
    <%= render "sidebar" %>
  </div>
</div>


<script
                          src="https://code.jquery.com/jquery-3.6.0.slim.js"
                          integrity="sha256-HwWONEZrpuoh951cQD1ov2HUK5zA5DwJ1DNUXaM6FsY="
                          crossorigin="anonymous"></script>
  <script defer>
    $("#all_participants").click(function(){
        $('input:checkbox').not(this).prop('checked', this.checked);
    });
  </script>
