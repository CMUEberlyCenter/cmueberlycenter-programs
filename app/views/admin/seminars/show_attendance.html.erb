<% update_document_title(add: "#{@seminar.title}") %>
<% update_breadcrumbs(add: link_to('Seminars', seminars_path)) %>
<% update_breadcrumbs(add: "#{@seminar.title}") %>
<% content_for :nav do %>
<ul>
  <li class="parent ancestor">
    <%= link_to('Seminars', seminars_path) %>
    <ul>
      <li>
        <%= link_to('Create New Seminar', new_seminar_path) %>
      </li>
      <li class="active">
        <%= link_to("#{@seminar.title}", seminar_attendance_url(@seminar)) %>
      </li>
    </ul>
  </li><li>
    <%= link_to('Registrations', registrations_path) %>
  </li><li>
    <%= link_to('Participants', participants_path) %>
  </li><li>
    <%= link_to('Future Faculty Program', future_faculty_path) %>
  </li><li>
    <%= link_to('Application Settings', settings_path) %>
  </li>
</ul>
<% end %>

<div class="content">
  <div>
    <h1><%= @seminar.title %></h1>
    <p class="date"><%= raw @seminar.formatted_timespan %></p>
    <p class="description"><%= raw @seminar.description %></p>


  <h2>Attendance Management</h2>

  <%= form_tag change_attendance_status_multiple_path(seminar: @seminar), method: :patch do %>
  <div>

    <p>
    <%= hidden_field_tag "selected", "" %>
    <%= select_tag 'attendance_status_key', options_for_select(Registration::AttendanceStatusType.actions_dropdown), class: 'inline' %>
    <%= submit_tag "Update Selected" %>
    </p>
  
  </div>

  <table>
      <tr style="color: #fff; background: #000;">
          <th class="p_select"><%= check_box_tag("all_participants","") %></th>
          <th>Name</th>
	  <th>Status</th>
	  <th>Affiliation</th>
	  <th style="width:300px">Mark As</th>
      </tr>
      <!--<tr><td colspan="4" id="add-participant2"><%= link_to( "Add Participant", new_admin_seminar_registration_path(@seminar), :remote => true ) %></td>
        <td>Attended</td>
      </tr>-->
      <% @seminar.registrations.confirmed.reject{|r| r.participant.nil? }.sort { |a,b| a.participant.name <=> b.participant.name }.each do |registration| %>

      <tr>
	<td class="p_select"><%= check_box_tag("participants[select_#{registration.participant.andrewid}]", registration.participant.andrewid, false, class: 'participant') %></td>
	<td><%= link_to "#{registration.participant.name} ( #{registration.participant.andrewid })", participant_path(registration.participant) %></td>
	<% label = registration.attendance_status.label if registration.attendance_status %>
	<% label = "Absent" if label == "Absent (Unexcused)" %>
	      <td><%= label %><%#= registration.attendance_status.label if registration.attendance_status %></td>
	      <td><%= registration.participant.student_class %></td>
              <td>
		<% if registration.attendance_status && registration.attendance_status.key != "attended" %>
		<%= button_to("Attended", { action: "change_attendance_status", id: registration, params: {new_status: 'attended'} },method: :patch,  class: "at-btn", style: "float: left") %>
		<% elsif registration.attendance_status.nil? %>
		<%= button_to("Attended", { action: "change_attendance_status", id: registration, params: {new_status: 'attended'} },method: :patch,  class: "at-btn", style: "float: left") %>
		<% end %>
		<% if registration.attendance_status && registration.attendance_status.key != "absent-unexcused" %>
		<%= button_to("Absent", { action: "change_attendance_status", id: registration, params: {new_status: 'absent-unexcused'} },method: :patch,  class: "at-btn", style: "float: left") %>
		<% elsif registration.attendance_status.nil? %>
		<%= button_to("Absent", { action: "change_attendance_status", id: registration, params: {new_status: 'absent-unexcused'} },method: :patch,  class: "at-btn", style: "float: left") %>
		<% end %>
		<% if registration.attendance_status && registration.attendance_status.key != "absent-excused" %>
		<%#= button_to("Absent (Exc.)", { action: "change_attendance_status", id: registration, params: {new_status: 'absent-excused'} },method: :patch,  class: "at-btn", style: "float: left") %>
		<% elsif registration.attendance_status.nil? %>
		<%#= button_to("Absent (Exc.)", { action: "change_attendance_status", id: registration, params: {new_status: 'absent-excused'} },method: :patch,  class: "at-btn", style: "float: left") %>
		<% end %>
              </td>
          </tr>
      <% end%>
  </table>
  <% end %>
  </div><div class="sidebar">
    <%= render "sidebar" %>
  </div>
</div>
<script
			  src="https://code.jquery.com/jquery-3.6.0.slim.js"
			  integrity="sha256-HwWONEZrpuoh951cQD1ov2HUK5zA5DwJ1DNUXaM6FsY="
			  crossorigin="anonymous"></script>
  <script defer>
    $("#all_participants").click(function(){
	$('input:checkbox').not(this).prop('checked', this.checked);
    });
  </script>
