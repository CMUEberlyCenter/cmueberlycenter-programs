<%= form_for @seminar, :url => @update_url do |f| %>

<% if @seminar.errors.any? %>
<div id="errorExplanation">
  <h2><%= pluralize(@seminar.errors.count, "error") %> prohibited
    this seminar from being saved:</h2>
  <ul>
    <% @seminar.errors.full_messages.each do |msg| %>
    <li><%= msg %></li>
    <% end %>
  </ul>
</div>
<% end %>

<%= f.hidden_field :id %>

<p>
  <%= f.label :title, 'Title:' %>
  <%= f.text_field :title, size: 32 %>
</p>

<p>
  <%= f.label :seminar_status_id, 'Seminar Status:' %>
  <%= f.collection_select(:seminar_status_id, Seminar::StatusType.all, :id, :key) %>
</p>
  
<p>
  <%= f.label :tags, 'Seminar Tags:' %>
  <%= f.text_field :tags, :value => @seminar.tags.join(","), :id => 'seminar-tags' %>
  <%# <form action="#">
    <fieldset>
        <div class="clearfix">
            <label>Seminar Tags</label>
            <div class="input">
              <ul id="tags-select" class="fake-input" tabindex="1">
                <li>U22</li>
              </ul>
            </div>
        </div>
    </fieldset>
  </form> %>
</p>

<p>
  <%= f.check_box :is_async, :id => 'async' %>
  <%= f.label :is_async, 'Async Session' %>
  
  <div class="unchecked">
    <%= f.label :start_at, 'Start At' %>
    <%= f.datetime_local_field :start_at, required: true %>
  </div>
  <div>
    <%= f.label :end_at, 'End At' %>
    <%= f.datetime_local_field :end_at, required: true %>
  </div>
</p>

<p>
  <%= f.check_box :enable_waitlist %>
  <%= f.label :enable_waitlist, 'Enable Waitlist' %>
</p>

<p>
  <%= f.label :maximum_capacity, 'Maximum Capacity:' %>
  <%= f.text_field :maximum_capacity %>
</p>

<p>
  <%= f.label :location, 'Location:' %>
  <%= f.text_field :location %>
</p>

<p>
  <%= f.label :description, 'Description:' %>
  <%= f.text_area :description, :size => "55x12" %>
</p>

<p>
  <%= f.label :pending_email_insert, 'Email Snippet for Pending Registrations:' %>
  <%= f.text_area :pending_email_insert, :size => "55x12" %>
</p>
  
<p>
  <%= f.label :confirmed_email_insert, 'Email Snippet for Confirmed Registrations:' %>
  <%= f.text_area :confirmed_email_insert, :size => "55x12" %>
</p>

<%= f.submit "Save", class: "btn" %> <%= link_to "Cancel", admin_seminars_url, class: "btn ghost" %>

<% end %>
