<% cmu_title "Edit", @seminar.title, "Seminars" %>
<% cmu_breadcrumb link_to("Seminars", seminars_path), link_to(@seminar.title, admin_seminar_path(@seminar)), "Edit" %>
<% cmu_nav "seminars" %>
<div class="content">
  <div>
    <h1>Edit <%= @seminar.title %></h1>
    <%= render "form", seminar: @seminar %>
    <h2 class="rule-top">Delete This Seminar</h2>
    <% if @seminar.registrations.any? %>
      <p>To delete this seminar, remove its registrations first.</p>
    <% else %>
      <%= button_to "Delete Seminar", seminar_path(@seminar), method: :delete, class: "btn ghost",
                    data: { turbo_confirm: "Delete #{@seminar.title}?" } %>
    <% end %>
  </div>
</div>
