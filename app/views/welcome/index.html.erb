<div class="content">
  <div>
    <%= greeting %>
    <% if @homepage_note.present? %>
      <%= sanitize @homepage_note %>
    <% else %>
      <p>The Eberly Center's seminars and workshops on teaching, for graduate students and postdocs. Find a program below and register for it.</p>
    <% end %>
  </div><div class="sidebar">
    <% if Current.user&.admin? %>
      <div class="simple">
        <%= link_to "Create Seminar", new_admin_seminar_path, class: "btn wide" %>
      </div>
    <% elsif Current.user %>
      <% if @sidebar_note.present? %>
        <div class="left-rule"><%= sanitize @sidebar_note %></div>
      <% end %>
      <div class="list left-rule">
        <h2>Learn More</h2>
        <ul>
          <li><%= link_to "Graduate Student Support", eberly_graduate_students_url, class: "external" %></li>
          <li><%= link_to "Future Faculty Program", eberly_future_faculty_program_url, class: "external" %></li>
        </ul>
      </div>
    <% else %>
      <div class="red invert">
        <h1>Register for Seminars</h1>
        <p>Sign in with your Andrew account to register and see your record.</p>
        <h4><%= button_to "Sign In", login_path, class: "btn ghost wide", form: { data: { turbo: false } } %></h4>
      </div>
    <% end %>
  </div>
</div>

<div class="content wide">
  <div>
    <% if @seminar_tags.any? %>
      <p class="cmu-label">Show Programs Tagged</p>
      <p class="prg-tags">
        <%= link_to "All", root_path(anchor: "programs"), class: ["btn small", ("ghost" if @tag)], "aria-current": (@tag ? nil : "true") %>
        <% @seminar_tags.each do |t| %>
          <%= link_to t, root_path(tag: t, anchor: "programs"), class: ["btn small", ("ghost" unless @tag == t)], "aria-current": (@tag == t ? "true" : nil) %>
        <% end %>
      </p>
    <% end %>
    <div id="programs">
      <%= render @seminar_groups %>
    </div>
  </div>
</div>
