<% content_for :nav do %>
  <%= render "nav" %>
<% end %>

<div class="content">
  <div>
    <%= greeting %>
    <%= @homepage_note&.html_safe %>
  </div><div class="sidebar">
    <% if Current.user&.admin? %>
    <div class="list left-rule">
      <h1>Admin Resources</h1>
      <ul>
        <li><%= link_to("Create New Seminar",
                new_admin_seminar_path) %></li>
      </ul>
    </div>
    <% elsif Current.user %>
      <% if @sidebar_note.present? %>
        <div class="left-rule">
          <%= @sidebar_note.html_safe %>
        </div>
      <% end %>
    <% else %>
    <%= render 'sessions/sidebar_login' %>
    <% end %>
  </div>
</div>

<%= filterable_list(@seminar_groups) %>
