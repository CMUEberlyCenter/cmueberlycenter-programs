<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= document_title %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# linked individually: propshaft 0.6 names application.css from its own source, so @imports went stale %>
    <%= stylesheet_link_tag "cmu", "eberly", "tabulator_cmu", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "application", :"data-turbo-track" => "reload" %>

    <link href="//www.cmu.edu/favicon.ico" rel="icon">
    <link href="//www.cmu.edu/favicon-152.png" rel="apple-touch-icon-precomposed">
    <meta content="#9f0000" name="msapplication-TileColor">
    <meta content="//www.cmu.edu/favicon-144.png" name="msapplication-TileImage">
  </head>

  <body class="no-js">
    <%= turbo_frame_tag "modal" %>

    <%= render 'layouts/impersonate_message' %>
    <div id="container">
      <%= image_tag('cmu-wordmark.png', id: 'wordmarkPrint') %>
      <header>
        <div class="roof">
          <div>
            <%= link_to("Carnegie Mellon University",
                "http://www.cmu.edu/",
                { class: "wordmark" }) %>
            <a aria-label="Jump to navigation" class="menu-btn" href="#nav"><b>&#8212;</b><b>&#8212;</b><b>&#8212;</b></a>

	    <%  if Current.user && Current.user.admin? %>
	      <%= form_tag(search_participants_path, id: 'site-search', method: 'get', class: 'search', data: {controller: 'search'} ) do %>
	      <label><span>Search</span>
		<%= text_field_tag(:q, '', { autocomplete: 'off', placeholder: 'Search', data: { action: 'keyup->search#lookupParticipants', behavior: "autocomplete", 'search-target': 'q' }} ) %>
	      </label>
	      <%= button_tag("Search") %>
	      <ul id="site-search-results">
	      </ul>
	      <% end %>

	      
	    <% end %>
	    
          </div>
        </div>

        <div id="sitename">
	  <h1><%= link_to('Seminars & Workshops', root_url) %></h1>
	  <h2><%= link_to('Eberly Center', eberly_url) %></h2>
        </div>
      </header>

      <div id="content">
        <div class="breadcrumbs">
	  <%= breadcrumbs %>
        </div>

	<% flash.each do |name, message| -%>
	<div class="content wide flash none <%= flash_css_class(name) %>" role="alert">
          <%= message.html_safe %>
        </div>
	<% end %>
	  
	<%= yield %>	
      </div>
      <%= render partial: "layouts/footer" %>
    </div>
  </body>
</html>
