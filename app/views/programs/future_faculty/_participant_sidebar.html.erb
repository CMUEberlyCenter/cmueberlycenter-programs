<%# locals: (participant:) -%>
<% enrolled = participant.future_faculty_enrollment.present? %>
<% status = participant.future_faculty_progress_status&.key %>
<div class="red invert" id="future-faculty-participant-sidebar">
  <h1>Future Faculty Program</h1>
  <% if enrolled %>
    <p><strong>Status:</strong> <%= ffp_status_name(participant.future_faculty_progress_status) %>
      <% if status == "graduated" %><br><strong>Completed:</strong> <%= ap_date(participant.future_faculty_program_graduated_on) || "Not recorded" %><% end %>
      <br><strong>Requirements:</strong> <%= participant.future_faculty_enrollment.key %>
    </p>
    <% case status %>
    <% when "complete" %>
      <%= button_to "Graduate #{participant.name}", graduate_future_faculty_path(participant), method: :patch, class: "btn ghost wide",
                    data: { turbo_confirm: "Graduate #{participant.name} from the Future Faculty Program?" } %>
    <% when "incomplete" %>
      <%= button_to "Graduate Anyway", graduate_future_faculty_path(participant), method: :patch, class: "btn ghost wide",
                    data: { turbo_confirm: "Graduate #{participant.name} before they meet the requirements?" } %>
      <%= button_to "Mark as Left CMU", drop_future_faculty_path(participant), method: :patch, class: "btn ghost wide",
                    data: { turbo_confirm: "Mark #{participant.name} as no longer at CMU?" } %>
    <% when "graduated" %>
      <%= button_to "Undo Graduation", ungraduate_future_faculty_path(participant), method: :patch, class: "btn ghost wide",
                    data: { turbo_confirm: "Undo #{participant.name}'s graduation?" } %>
    <% when "dropout" %>
      <%= button_to "Re-Enroll #{participant.name}", reenroll_future_faculty_path(participant), method: :patch, class: "btn ghost wide",
                    data: { turbo_confirm: "Re-enroll #{participant.name} in the Future Faculty Program?" } %>
    <% end %>
  <% else %>
    <p>Not enrolled.</p>
    <%= button_to "Enroll #{participant.name}", enroll_future_faculty_path(participant), method: :patch, class: "btn ghost wide" %>
  <% end %>
</div>
