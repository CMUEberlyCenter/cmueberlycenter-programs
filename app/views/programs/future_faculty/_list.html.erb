<div id="filterrific_results">
  <%== pagy_items_selector_js(@pagy, item_name: 'Activities'.pluralize(@pagy.count)) %>
  <table class="alternate">
    <thead class="invert">
      <tr>
	<th><%= filterrific_sorting_link(@filterrific, :created_at) %></th>
	<th><%= filterrific_sorting_link(@filterrific, :name) %></th>
	<th>Andrew ID</th>
	<th>Department</th>
	<th>School</th>
	<th>Student Class</th>
	<th>FFP Graduation Date</th>
	<th>Status</th>
	<th>First Consultation On</th>
	<th>Category</th>
	<th>Type</th>
	<th>Activity Title</th>
	<th>Description</th>
	<th>Course</th>
	<th>Observer</th>
	<th>Lead Consultant</th>
	<th>Completed On</th>
	<th>Memo Completed On</th>
	<th>Internal Notes</th>
      </tr>
    </thead>
    <tbody>
      <% activities.each do |a| %>
      <% p = a.participant %>
      <% next if p.nil? %>
      <tr>
        <td><%= a.created_at.to_formatted_s(:short) %></td>
        <td><%= link_to p.name ? p.name : p.andrewid, participant_url(p.andrewid) %></td>
        <td><%= p.andrewid %></td>
	<td><%= p.pretty_depts %></td>
        <td><%= p.college%></td>
        <td><% unless p.student_class.nil? %><%= p.student_class %><% end %></td>
        <td><%= p.future_faculty_program_graduated_on%></td>
        <td><%= p.future_faculty_progress_status ? p.future_faculty_progress_status.label : ''%></td>
	<td><%= p.first_consultation_on %></td>
	<td><%= a.future_faculty_requirement ? a.future_faculty_requirement.requirement_category.label : 'Other Activities' %></td>
	<td><%= a.future_faculty_requirement ? a.future_faculty_requirement.label : '' %></td>
	<td><%= a.title %></td>
	<td><%= a.description %></td>
	<td><%= a.course %></td>
	<td><%= a.observer ? a.observer.name : '' %></td>
	<td><%= a.lead_consultant ? a.lead_consultant.name : '' %></td>
	<td><%= a.completed_on %></td>
	<td><%= a.memo_completed_on %></td>
	<td><%= a.internal_notes %></td>
      </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav_js(@pagy) %>
</div>
