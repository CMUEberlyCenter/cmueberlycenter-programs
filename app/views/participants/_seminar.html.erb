<h4>
  <%= seminar.title_with_indicia %>
  &nbsp;
  <% date = seminar.start_at.is_a?(DateTime) ? seminar.start_at.to_date : seminar.end_at.to_date %>
 <% begin%>
           <% date = "[ #{seminar.start_at.strftime("%b %d, %Y")} ]"%>
     <% rescue%>
          <% date = "[ Async, #{seminar.end_at.strftime("%Y")} ]"%>
     <% end%>
  <small><%= date%> <%#= I18n.l(date, format: :prose) %> </small>
</h4>
