<%# locals: (seminars:) -%>
<% if seminars.any? %>
  <ul class="prg-attended">
    <% seminars.sort_by { |s| s.start_at || s.end_at }.each do |seminar| %>
      <li><%= seminar.title_with_indicia %> <span class="cmu-muted">(<%= seminar_day(seminar) %>)</span></li>
    <% end %>
  </ul>
<% else %>
  <p class="cmu-empty">None yet.</p>
<% end %>
