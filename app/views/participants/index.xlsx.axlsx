wb = xlsx_package.workbook
counts_by_participant = Participant.table_rows(@participants).index_by { |row| row['id'] }
wb.add_worksheet(name: "Participants") do |sheet|
  sheet.add_row ["Last Change", "Name", "Andrew ID", "Department", "School", "Student Class", "First Consultation",
                 "FFP Status", "Graduated", *ParticipantsHelper::COUNT_COLUMNS.values]
  @participants.each do |p|
    row = counts_by_participant.fetch(p.id)
    sheet.add_row [p.updated_at,
                   p.name,
                   p.andrewid,
                   p.pretty_depts,
                   p.pretty_colleges,
                   p.student_class,
                   p.first_consultation_on,
                   ParticipantsHelper::FFP_STATUS_NAMES[row['ffp_status']],
                   p.future_faculty_program_graduated_on] + row.values_at(*ParticipantsHelper::COUNT_COLUMNS.keys)
  end
end
