<% cmu_title "People" %>
<% cmu_breadcrumb "People" %>
<% complete = @ffp_status == "complete" %>
<div class="content wide">
  <div>
    <h1><%= complete ? "Participants Who Met the FFP Requirements" : "People" %></h1>
    <% if complete %>
      <p><%= link_to "Show Everyone", participants_path, class: "cta" %></p>
    <% end %>
    <p><%= link_to "Spreadsheet of #{pluralize(@rows.size, 'Person', plural: 'People')}", participants_path(format: :xlsx, ffp_status: @ffp_status),
                   download: true %> [XLSX]</p>

    <%= form_with url: participants_path, method: :get, data: { controller: "people-search", people_search_url_value: search_participants_path } do %>
      <label for="prg-look-up">Look Up Someone at CMU</label>
      <div class="cmu-suggest">
        <input type="search" id="prg-look-up" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="prg-look-up-list"
               autocomplete="off" aria-describedby="prg-look-up-hint" data-people-search-target="input"
               data-action="input->people-search#suggest cmu-suggest-pick->people-search#open">
        <ul class="cmu-suggest-list" id="prg-look-up-list" role="listbox" aria-label="Suggestions" hidden data-people-search-target="list"></ul>
      </div>
      <p class="cmu-hint" id="prg-look-up-hint">By name or Andrew ID. Picking someone opens their page and adds them as a participant.</p>
    <% end %>

    <h2 class="rule-top">Everyone</h2>
    <div class="cmu-search-bar">
      <p>Search by name, Andrew ID, department or school.</p>
      <label for="prg-participant-search" class="sr-only">Find a Participant</label>
      <input type="text" id="prg-participant-search" placeholder="Find a participant&hellip;" data-cmu-filter="prg-participants">
    </div>
    <div class="prg-scroll">
    <table class="alternate cmu-full prg-wide-table" id="prg-participants" data-cmu-table data-cmu-noun="participant">
      <thead>
        <tr>
          <th scope="col" data-sort-key="name"><button type="button" class="cmu-sort">Name<span class="cmu-sort-arrow"></span></button></th>
          <th scope="col" data-sort-key="andrewid"><button type="button" class="cmu-sort">Andrew ID<span class="cmu-sort-arrow"></span></button></th>
          <th scope="col" data-sort-key="department"><button type="button" class="cmu-sort">Department<span class="cmu-sort-arrow"></span></button></th>
          <th scope="col" data-sort-key="school"><button type="button" class="cmu-sort">School<span class="cmu-sort-arrow"></span></button></th>
          <th scope="col" data-sort-key="class"><button type="button" class="cmu-sort">Student Class<span class="cmu-sort-arrow"></span></button></th>
          <th scope="col" data-sort-key="first"><button type="button" class="cmu-sort">First Consultation<span class="cmu-sort-arrow"></span></button></th>
          <th scope="col" data-sort-key="status"><button type="button" class="cmu-sort">FFP Status<span class="cmu-sort-arrow"></span></button></th>
          <th scope="col" data-sort-key="graduated"><button type="button" class="cmu-sort">Graduated<span class="cmu-sort-arrow"></span></button></th>
          <% ParticipantsHelper::COUNT_COLUMNS.each do |field, title| %>
            <th scope="col" class="num" data-sort-key="<%= field %>"><button type="button" class="cmu-sort"><%= title %><span class="cmu-sort-arrow"></span></button></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr>
            <td data-sort-value="<%= row['sortable_name'] %>"><%= link_to row['name'] || row['andrewid'], participant_path(row['andrewid']) %></td>
            <td><%= row['andrewid'] %></td>
            <td><%= row['pretty_depts'] %></td>
            <td><%= row['pretty_colleges'] %></td>
            <td><%= row['student_class'] %></td>
            <td data-sort-value="<%= row['first_consultation_on'] %>"><%= ap_date(row['first_consultation_on']&.to_date) %></td>
            <td><%= ParticipantsHelper::FFP_STATUS_NAMES[row['ffp_status']] %></td>
            <td data-sort-value="<%= row['future_faculty_program_graduated_on'] %>"><%= ap_date(row['future_faculty_program_graduated_on']&.to_date) %></td>
            <% ParticipantsHelper::COUNT_COLUMNS.each_key do |field| %>
              <td class="num"><%= row[field] %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
    <p class="cmu-results-count" data-cmu-count="prg-participants" aria-live="polite">Showing all <%= pluralize(@rows.size, "participant") %></p>
  </div>
</div>
