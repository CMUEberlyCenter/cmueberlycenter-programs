<div id="filterrific_results">
  <%== pagy_items_selector_js(@pagy, item_name: 'Participant'.pluralize(@pagy.count)) %>
  <table class="alternate">
    <thead class="invert">
      <tr>
        <th>Last Change</th>
        <th>Name</th>
        <th>Andrew ID</th>
        <th>Department</th>
        <th>School</th>
        <th>Student Class</th>
        <th>FFP Graduation Date</th>
	<th>FFP Status</th>
	<th>First Consultation On</th>
      </tr>
    </thead>
    <tbody>
      <% participants.each do |p| %>
      <tr>
	<td><%= p.updated_at %><%#.to_formatted_s(:short) %></td>
        <td><%= link_to p.name, participant_url(p.andrewid) %></td>
        <td><%= p.andrewid %></td>
        <td><%= p.pretty_depts %></td>
        <td><%= p.pretty_colleges %></td>
        <td><%= p.student_class %></td>
        <td><%= p.future_faculty_program_graduated_on%></td>
        <td><%= p.future_faculty_progress_status.label if p.future_faculty_progress_status %></td>
	<td><%= p.first_consultation_on %></td>
      </tr>
      <% end %>
    </tbody>
  </table>
  <%== pagy_nav_js(@pagy) %>
</div>
