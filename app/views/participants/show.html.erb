<% update_document_title(add: [@participant.name,'Participants']) %>
<% update_breadcrumbs(add: [link_to('Participants',participants_path),"#{@participant.name}"]) %>
<% content_for :nav do %>
<li class="parent">
  <%= link_to('Seminars', seminars_path) %>
  <ul>
    <li>
      <%= link_to('Create New Seminar', new_seminar_path) %>
    </li>
  </ul>
</li><li>
  <%= link_to('Registrations', registrations_path) %>
</li><li class="active">
  <%= link_to('Participants', participants_path) %>
</li><li>
  <%= link_to('Future Faculty Program', future_faculty_path) %>
</li><li>
  <%= link_to('Application Settings', settings_path) %>
</li>
<% end %>

<div class="content">
  <div>
    <h1><%= @participant.name %></h1>
    <p>
      <strong>Andrew ID:</strong> <%= @participant.andrewid %><br/>
      <strong>Email:</strong> <%= mail_to @participant.email, @participant.email %><br/><br/>

      <strong>College:</strong> <%= @participant.pretty_colleges.blank? ? "N/A" : @participant.pretty_colleges %><br/>
      <strong>Former College:</strong> <%= @participant.pretty_colleges_archive.blank? ? "N/A" : @participant.pretty_colleges_archive %><br/></br>
      <strong>Department:</strong> <%= @participant.pretty_depts.blank? ? "N/A" : @participant.pretty_depts %><br/>
      <strong>Former Department:</strong> <%= @participant.pretty_depts_archive.blank? ? "N/A" : @participant.pretty_depts_archive %><br/></br>
      <strong>Student Class:</strong> <%= @participant.student_class || "N/A" %><br/>
      <strong>Former Student Class:</strong> <%= @participant.student_class_archive || "N/A" %><br/>
    </p>
    <hr/>
    <%= turbo_frame_tag 'ffp_activities' do %>
    <%# unless Programs::FutureFaculty::Enrollment.find( @participant ).nil? %>
 
    <%= render('activities/future_faculty_program', participant: @participant ) %>
    <%# end %>

    <% end %>
    <%= render "activities/additional", participant: @participant %>
    <hr/>
    <%= render partial: "seminars", object: @participant.attended_seminars, locals: { title: "Seminars" } %>
    <hr/>
    <% workshops_and_other = @participant.attended_workshops + @participant.attended_other %>
    <%= render partial: "seminars", object: workshops_and_other, locals: { title: "Workshops and Other Programming" } %>
    <hr/>
    <%= render "notes", participant: @participant %>
</div><div class="sidebar">
    <div class="simple">
      <p><%= link_to("Download Participation Record (.pdf)",
             participant_path(:id => @participant.andrewid, :format => :pdf), class: "btn wide") %></p>
      <p>
	<% if Current.imposter %>
	<%= button_to("Stop Impersonating #{Current.user.name}",
            unimpersonate_path,{ method: :post, class: "ghost wide"}) %>
	<% else %>
	<%= button_to("Impersonate #{@participant.name}",
            impersonate_path( @participant.andrewid ),{ method: :post, class: "ghost wide"}) %>
	<% end %>
      </p>
    </div>
    <div class="simple">
      <%= render "programs/future_faculty/participant_sidebar" %>
    </div>
  </div>
</div>
