<% cmu_title @participant.name, "Participants" %>
<% cmu_breadcrumb link_to("Participants", participants_path), @participant.name %>
<% cmu_nav "participants" %>
<%= turbo_frame_tag "modal" %>
<div class="content">
  <div>
    <h1><%= @participant.name %></h1>
    <dl class="prg-facts">
      <dt>Andrew ID</dt><dd><%= @participant.andrewid %></dd>
      <dt>Email</dt><dd><%= @participant.email.present? ? mail_to(@participant.email) : "None" %></dd>
      <dt>Student Class</dt><dd><%= @participant.student_class.presence || "None" %></dd>
      <dt>School</dt><dd><%= @participant.pretty_colleges.presence || "None" %></dd>
      <dt>Department</dt><dd><%= @participant.pretty_depts.presence || "None" %></dd>
      <% if @participant.student_class_archive.present? || @participant.pretty_colleges_archive.present? || @participant.pretty_depts_archive.present? %>
        <dt>Before</dt>
        <dd><%= [@participant.student_class_archive, @participant.pretty_colleges_archive, @participant.pretty_depts_archive].compact_blank.join("; ") %></dd>
      <% end %>
      <dt>First Consultation</dt><dd><%= ap_date(@participant.first_consultation_on) || "None" %></dd>
    </dl>

    <h2 class="rule-top">Future Faculty Program Activities</h2>
    <%= turbo_frame_tag "ffp_activities" do %>
      <%= render "activities/future_faculty_program", participant: @participant %>
    <% end %>

    <h2 class="rule-top">Other Activities and Consultations</h2>
    <%= turbo_frame_tag "activities" do %>
      <%= render "activities/additional_list", participant: @participant %>
    <% end %>

    <h2 class="rule-top">Seminars Attended</h2>
    <%= render "attended", seminars: @participant.attended_seminars %>

    <h2 class="rule-top">Workshops and Other Programs Attended</h2>
    <%= render "attended", seminars: @participant.attended_workshops + @participant.attended_other %>

    <h2 class="rule-top">Internal Notes</h2>
    <%= form_with model: @participant, scope: :participant, url: participant_path(@participant), method: :patch do |f| %>
      <%= f.label :note, "Notes", class: "sr-only" %>
      <%= f.text_area :note, rows: 4, "aria-describedby": "prg-note-hint" %>
      <p class="cmu-hint" id="prg-note-hint">Only administrators see these.</p>
      <p><%= f.submit "Save Notes", class: "btn" %></p>
    <% end %>
  </div><div class="sidebar">
    <div class="simple">
      <p><%= link_to "View Participation Record", record_participant_path(@participant), class: "btn wide" %></p>
      <% unless @participant == Current.user || Current.imposter %>
        <div class="prg-button"><%= button_to "Act as #{@participant.name}", act_as_path(@participant), class: "btn ghost wide", form: { data: { turbo: false } } %></div>
      <% end %>
    </div>
    <%= render "programs/future_faculty/participant_sidebar", participant: @participant %>
  </div>
</div>
