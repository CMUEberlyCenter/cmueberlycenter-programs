<% cmu_title "Admin" %>
<% cmu_breadcrumb "Admin" %>
<div class="content">
  <div>
    <h1>Admin</h1>
    <h2>Display</h2>
    <% @settings.each do |setting| %>
      <%= form_with model: setting, url: setting_path(setting), method: :patch do |f| %>
        <%= f.label :value, setting.label, for: "setting-#{setting.id}" %>
        <div class="cmu-field-button">
          <% if setting.key.start_with?("homepage-", "sidebar-") %>
            <%= f.text_area :value, id: "setting-#{setting.id}", rows: 3 %>
          <% else %>
            <%= f.text_field :value, id: "setting-#{setting.id}" %>
          <% end %>
          <%= f.submit "Save", class: "btn" %>
        </div>
      <% end %>
    <% end %>
  </div><div class="sidebar">
    <% @settings.sidebar_settings.each do |setting| %>
      <h2><%= setting.label %></h2>
      <div class="left-rule"><%= sanitize setting.value.to_s %></div>
    <% end %>
  </div>
</div>
<div class="grid column2">
  <% [["Administrators", @admins, :is_admin], ["Consultants", @consultants, :is_consultant]].each do |title, people, flag| %>
    <div>
      <h2><%= title %></h2>
      <%= form_with model: Participant.new, url: participants_path do |f| %>
        <%= f.label :andrewid, "Add by Andrew ID", for: "add-#{flag}" %>
        <div class="cmu-field-button">
          <%= f.text_field :andrewid, id: "add-#{flag}", autocomplete: "off" %>
          <%= f.hidden_field flag, value: true, id: nil %>
          <%= f.submit "Add", class: "btn" %>
        </div>
      <% end %>
      <table class="alternate cmu-full">
        <thead><tr><th scope="col">Name</th><th scope="col" class="cmu-fit">Andrew ID</th><th scope="col" class="cmu-fit"><span class="sr-only">Actions</span></th></tr></thead>
        <tbody>
          <% people.each do |person| %>
            <tr>
              <td><%= link_to person.name, participant_path(person) %></td>
              <td class="cmu-fit"><%= person.andrewid %></td>
              <td class="cmu-fit">
                <%= button_to "Remove", participant_path(person), method: :patch, params: { participant: { flag => false } },
                              class: "btn small ghost", data: { turbo_confirm: "Remove #{person.name} from #{title.downcase}?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
