<div class="filter-container">
  <div class="content">
    <div>
      <h2>Find a Seminar</h2>
      <!--
	<form role="form">
        <label for="fs1"><strong>Search Filter</strong></label>
        <input id="fs1" type="text" class="filter-search" autocomplete="off" placeholder="strategies for grading"/>
      </form>
      -->
      <label for="fc1"><strong>Filter Seminars By Tag</strong></label>
      <div id="fc1" class="filter-controls">
        <a class="btn" href="#seminars" data-filter="all">All</a>
        <% @seminar_tags.each do |t| %>
        <a class="btn ghost" href="#seminars" data-filter="<%= t %>"><%= t %></a>
        <% end %>
      </div>
    </div>
  </div>
  <div id="seminars" class="filter-list boxes teal grid column2">
    <%= render seminar_groups %>
    <div class="no-result"><h2><%= no_results_message %></h2></div>
  </div>
</div>
