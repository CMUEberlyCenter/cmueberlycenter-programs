<div class="item <%= seminar.tags.join(' ') %>">
  <h2><%= seminar.title %></h2>
  <h3><%= seminar.formatted_timespan %></h3>
  <h3>
    <%= "This seminar is asynchronous." if seminar.async? %>
    <%= seminar.location %>
  </h3>
  <p><%= seminar.description&.html_safe %></p>
  <h4 class="alignright">Tags: <%= seminar.tags.join(', ') %></h4>

  <% if Current.user&.admin? %>
    <%= admin_options(seminar) %>
  <% elsif Current.user %>
    <%= registration_options(seminar) %>
  <% else %>
    <%= guest_options(seminar) %>
  <% end %>
</div>
