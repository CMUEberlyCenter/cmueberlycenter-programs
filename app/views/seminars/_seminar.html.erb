<div>
  <h3><%= seminar.title %></h3>
  <p class="date"><strong><%= seminar_when(seminar) %></strong><% if seminar.location.present? %><br><%= seminar.location %><% end %></p>
  <%= sanitize seminar.description %>
  <p><%= tag_pills(seminar.tags) %></p>
  <% if Current.user&.admin? %>
    <%= render "seminars/admin_options", seminar: %>
  <% elsif Current.user %>
    <%= render "seminars/registration_options", seminar: %>
  <% elsif seminar.open? %>
    <div class="prg-button"><%= button_to "Sign In to Register", login_path(return_to: root_path), class: "btn small ghost", form: { data: { turbo: false } } %></div>
  <% end %>
</div>
