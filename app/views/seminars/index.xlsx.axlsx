wb = xlsx_package.workbook
wb.add_worksheet(name: "Seminars") do |sheet|
  sheet.add_row ["ID", "Title", "Maximum Capacity", "Status", "Location", "Starts", "Ends", "Tags"]
  @seminars.each do |s|
    sheet.add_row [s.id, s.title, s.maximum_capacity, s.seminar_status&.key, s.location,
                   s.start_at || "Asynchronous", s.end_at, s.tags.join(",")]
  end
end
