<%= tag.div(class: ["content wide", seminar_group.color, ("invert" if seminar_group.invert?)]) do %>
  <div>
    <h1><%= seminar_group.title %></h1>
    <% if seminar_group.seminars.empty? %>
      <p>None right now.</p>
    <% end %>
  </div>
<% end %>
<% if seminar_group.seminars.any? %>
  <div class="grid column2 <%= seminar_group.color %> boxes prg-seminars">
    <%= render partial: "seminars/seminar", collection: seminar_group.seminars %>
  </div>
<% end %>
