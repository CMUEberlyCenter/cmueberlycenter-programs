<%# locals: (seminar:) -%>
<% registration = Current.user.registrations.find_by(seminar:) %>
<% if registration&.confirmed? %>
  <p><span class="cmu-pill cmu-pill--green">Registered</span></p>
<% elsif registration&.pending? %>
  <p><span class="cmu-pill cmu-pill--amber">Waitlisted</span></p>
<% elsif seminar.open? %>
  <% if Current.user.registrations.joins(:seminar).where(seminars: { title: seminar.title }).exists? %>
    <p class="cmu-hint">You may have taken this program before. Check your record before you register again.</p>
  <% end %>
  <div class="prg-button"><%= button_to(seminar.enable_waitlist? ? "Request a Seat" : "Register", seminar_registrations_path(seminar), class: "btn") %></div>
<% end %>
<% if registration %>
  <div class="prg-card-links">
    <%= mail_to "seminars@eberly.cmu.edu", "Request Accommodations", subject: "Accommodations for #{seminar.title}" %> |
    <%= button_to (registration.confirmed? ? "Cancel Registration" : "Cancel Request"), registration_path(registration),
                  method: :delete, class: "cmu-link-button", form_class: "prg-inline-form",
                  data: { turbo_confirm: "Cancel your #{registration.confirmed? ? 'registration' : 'request'} for #{seminar.title}?" } %>
  </div>
<% end %>
