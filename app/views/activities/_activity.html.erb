<%# locals: (activity:) -%>
<div class="prg-activity">
  <h4><%= activity_name(activity) %></h4>
  <dl class="prg-facts">
    <% activity_fields(activity).each do |field| %>
      <% next if field == :title %>
      <% value = activity_field_value(activity, field) %>
      <% next if value.blank? && %i[description internal_notes course].include?(field) %>
      <dt><%= activity_field_label(activity, field) %></dt>
      <dd><%= value.presence || "Not yet" %></dd>
    <% end %>
  </dl>
  <div class="prg-actions">
    <%= link_to "Edit", edit_activity_path(activity), class: "btn small ghost", data: { turbo_frame: "modal" } %>
    <%= button_to "Delete", activity_path(activity), method: :delete, class: "btn small ghost",
                  data: { turbo_confirm: "Delete #{activity_name(activity)}?" } %>
  </div>
</div>
