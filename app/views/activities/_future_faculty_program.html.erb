<%# locals: (participant:) -%>
<% version = participant.future_faculty_enrollment || Programs::FutureFaculty::RequirementsVersion.last %>
<% requirements = version.requirements.group_by(&:requirement_category) %>
<% version.categories.each do |category| %>
  <h3><%= category.label %></h3>
  <% requirements.fetch(category, []).each do |requirement| %>
    <%= render partial: "activities/activity", collection: participant.activities.where(type: requirement.activity_class) %>
    <p><%= link_to "Add #{requirement.label}", new_participant_activity_path(participant, type: requirement.activity_class, requirement_id: requirement.id),
                   class: "btn small ghost", data: { turbo_frame: "modal" } %></p>
  <% end %>
<% end %>
