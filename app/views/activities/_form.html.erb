<%# locals: (activity:, participant:, url:, title:) -%>
<%= turbo_frame_tag "modal" do %>
  <dialog class="cmu-dialog prg-activity-dialog" aria-labelledby="prg-activity-title" data-controller="dialog">
    <%= form_with model: activity, scope: :activity, url: do |f| %>
      <h2 id="prg-activity-title"><%= title %></h2>
      <%= f.hidden_field :type %>
      <%= f.hidden_field :future_faculty_requirement_id %>
      <% consultants = Participant.consultants.reorder(:sortable_name) %>
      <% activity_fields(activity).each do |field| %>
        <% label = activity_field_label(activity, field) %>
        <% case field %>
        <% when :title, :course %>
          <%= f.label field, label %><%= f.text_field field %>
        <% when :description, :internal_notes %>
          <%= f.label field, label %><%= f.text_area field, rows: 3 %>
        <% when :lead_consultant_id, :observer_id %>
          <%= f.label field, label %>
          <%= f.collection_select field, consultants, :id, :name, { include_blank: "None" }, class: "inline" %>
        <% else %>
          <%= f.label field, label %><%= f.date_field field, class: "inline" %>
        <% end %>
      <% end %>
      <div class="cmu-dialog-buttons">
        <%= f.submit activity.persisted? ? "Save Activity" : "Add Activity", class: "btn" %>
        <button type="submit" class="btn ghost" formmethod="dialog" formnovalidate>Cancel</button>
      </div>
    <% end %>
  </dialog>
<% end %>
