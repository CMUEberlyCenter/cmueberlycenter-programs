<% cmu_title "My Registrations" %>
<% cmu_breadcrumb "My Registrations" %>
<div class="content wide">
  <div>
    <h1>My Registrations</h1>
    <% if @registrations.any? %>
      <p class="cmu-lead">The programs you're signed up for that haven't happened yet.</p>
      <table class="alternate cmu-full">
        <thead>
          <tr>
            <th scope="col">Program</th>
            <th scope="col">When</th>
            <th scope="col">Where</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @registrations.each do |registration| %>
            <% seminar = registration.seminar %>
            <tr>
              <td><%= seminar.title %></td>
              <td><%= seminar_when(seminar) %></td>
              <td><%= seminar.location %></td>
              <td>
                <% if registration.confirmed? %>
                  <span class="cmu-pill cmu-pill--green">Registered</span>
                <% else %>
                  <span class="cmu-pill cmu-pill--amber">Waitlisted</span>
                <% end %>
              </td>
              <td>
                <%= button_to (registration.confirmed? ? "Cancel Registration" : "Cancel Request"), registration_path(registration),
                              method: :delete, class: "btn small ghost",
                              data: { turbo_confirm: "Cancel your #{registration.confirmed? ? 'registration' : 'request'} for #{seminar.title}?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="cmu-lead">You're not signed up for anything coming up.</p>
      <p><%= link_to "Find a Program", root_path, class: "cta" %></p>
    <% end %>
  </div>
</div>
